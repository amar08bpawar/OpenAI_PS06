# ==============================================================================
# Placement Hub - Environment Variables Template
# Copy this file to .env.local for local development:
#   cp .env.example .env.local
#
# IMPORTANT:
# - NEVER commit .env or .env.local files containing real secrets to version control.
# - SUPABASE_SERVICE_ROLE_KEY is server-side ONLY. Never prefix it with NEXT_PUBLIC_.
# ==============================================================================

# Supabase Project URL (found in Supabase Dashboard -> Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Anon / Publishable Key (safe for browser client-side queries with RLS)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-placeholder

# Supabase Service Role Key (SERVER-SIDE ONLY - bypasses RLS for trusted admin actions)
# DO NOT expose this key to browser code or prefix it with NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-placeholder

# Optional Application URL (used for redirect URLs in auth confirmation emails)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
